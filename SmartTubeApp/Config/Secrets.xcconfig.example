// SmartTube - signing configuration.
// 1. Copy this file to Config/Secrets.xcconfig
// 2. Fill in your Apple Developer Team ID (never commit Secrets.xcconfig — it is gitignored)
// Find your Team ID at: https://developer.apple.com/account/#/membership

SMARTTUBE_TEAM_ID = YOUR_TEAM_ID

// Used for the Apple TV target which requires separate SDK-conditional signing.
// Set to the same value as SMARTTUBE_TEAM_ID unless you have a separate TV team.
SMARTTUBE_TV_TEAM_ID = YOUR_TEAM_ID
